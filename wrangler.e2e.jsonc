{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "llm-chat-app-template-e2e",
	"vars": { "ACCOUNTS_REQUIRED": "false" },
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"durable_objects": {
		"bindings": [{ "name": "USAGE", "class_name": "UsageGate" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageGate"] }],
	"ratelimits": [
		{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "CHAT_LIMIT", "namespace_id": "1002", "simple": { "limit": 18, "period": 60 } }
	],
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": true,
		"directory": "./public"
	}
}
